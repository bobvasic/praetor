# Praetor environment variables.
# Mirror of all 8 variables configured in DigitalOcean App Platform.
# Do not commit real secrets — this file is the public template only.

# ---------- QuickNode (server-only) ----------
# Required: Solana Devnet RPC endpoint from QuickNode. Powers /api/solana/*.
QUICKNODE_RPC_URL=
# Optional shared secret used to validate QuickNode webhook POSTs at /api/webhooks/quicknode.
QUICKNODE_WEBHOOK_SECRET=

# ---------- Anchor program IDs ----------
# Public devnet deployment for the Praetor Anchor program.
PRAETOR_PROGRAM_ID=HKQ5WMoZFuT2zrDJyoKKpQFLQgtVMsuHUhuAM1DcqLbk
NEXT_PUBLIC_PRAETOR_PROGRAM_ID=HKQ5WMoZFuT2zrDJyoKKpQFLQgtVMsuHUhuAM1DcqLbk
DEMO_VAULT_PROGRAM_ID=

# ---------- Public app configuration ----------
# In production these point at https://praetores.com.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
# Keep as devnet for the MVP.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
