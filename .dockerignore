# Keep the Docker build context tiny and never ship secrets.
.git
.gitignore
.github
.next
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env (must NEVER be baked into image; DO injects env at runtime).
.env
.env.local
.env*.local

# Editor / OS noise.
.vscode
.idea
.DS_Store

# Documentation and large local artifacts not needed at runtime.
docs
README.md
*.md

# Solana Anchor workspace is not needed by the web runtime.
solana

# Tests and dev-only artifacts.
coverage
.nyc_output
*.tsbuildinfo
next-env.d.ts
